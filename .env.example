# WiFiLab configuration (all optional; defaults shown). No secrets are needed.
# Web UI port on 127.0.0.1; empty or 0 = a random free port (the running URL is in <data dir>/server.json)
WIFILAB_PORT=
# Scan history and surveys (SQLite); default ~/Library/Application Support/WiFiLab on macOS
WIFILAB_DATA_DIR=
# Scanner backend: auto (CoreWLAN on macOS, fake elsewhere), corewlan, fake
WIFILAB_SCANNER=auto
# Seconds between background scans (5..3600); can be changed in Settings
WIFILAB_SCAN_INTERVAL=15
# Days of scan history kept
WIFILAB_RETENTION_DAYS=14
# Start background scanning at launch (1/0)
WIFILAB_AUTOSCAN=1
